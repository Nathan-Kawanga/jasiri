# Copy to .env.local and fill in. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for sign-up, PIN resets, the public booking page and rate limits.
SUPABASE_SERVICE_ROLE_KEY=
# Public address of the app, used in booking links and QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
